# ~/.claude — track policy only (allowlist: ignore everything, un-ignore config/instructions)
*
!.gitignore
!CLAUDE.md
!settings.json
!modes.json
!README.md
!agents/
!agents/**
!commands/
!commands/**
!skills/
!skills/**
!workflows/
!workflows/**
!hooks/
!hooks/**
!specs/
!specs/**
!plans/
!plans/**
!schemas/
!schemas/**

# never track (explicit, in case an allowlisted dir ever contains them)
.mode
.credentials.json
settings.local.json
history.jsonl
projects/
sessions/
session-env/
shell-snapshots/
file-history/
cache/
debug/
downloads/
backups/
paste-cache/
tasks/
plugins/
