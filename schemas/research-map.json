{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "research-map",
  "type": "object",
  "required": ["answer", "locations", "open_questions"],
  "properties": {
    "answer": { "type": "string" },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
