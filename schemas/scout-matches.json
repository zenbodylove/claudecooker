{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "scout-matches",
  "type": "object",
  "required": ["matches"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "why"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "why": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
