{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/dispatch-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workflow-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
